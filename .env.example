# Public production URL, used for metadata, sitemap, robots, and structured data.
NEXT_PUBLIC_SITE_URL=

# Optional scheduling link (e.g. Cal.com or Calendly). When empty, the site
# offers a prefilled email to request a discovery call instead.
NEXT_PUBLIC_BOOKING_URL=

# Inquiry delivery via Resend (https://resend.com). Server-only; never exposed to the browser.
# All three must be set for the form to send. Without them, the form shows an email fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
